---
/**
 * Starlight の LinkCard に、右側の OGP 画像（正方形・object-fit: cover）を足したもの。
 * MDX の `import { LinkCard } from '@astrojs/starlight/components'` はそのまま使える
 * （astro.config.mjs の Vite プラグインが、この部品に差し替える）。
 *
 * 画像が出るのは外部リンク（http(s)）で og:image が取れたときだけ。取れなければ
 * Starlight 本来の見た目のまま。詳しくは src/lib/link-og-image.ts。
 * 見た目の骨格は Starlight 0.42 の LinkCard.astro と同じ。更新で差が出たらそちらに合わせる。
 */
import type { HTMLAttributes } from 'astro/types';
import { Icon as StarlightIcon } from '@astrojs/starlight/components';
import { getLinkOgImage } from '../lib/link-og-image';

interface Props extends Omit<HTMLAttributes<'a'>, 'title'> {
	title: string;
	description?: string;
}

const { title, description, ...attributes } = Astro.props;
const image = await getLinkOgImage(attributes.href as string | undefined);
---

<div class:list={['sl-link-card', { 'has-thumb': !!image }]}>
	<span class="sl-flex stack">
		<a {...attributes}>
			<span class="title" set:html={title} />
		</a>
		{description && <span class="description" set:html={description} />}
	</span>
	{
		image && (
			<img
				class="thumb"
				src={image}
				alt=""
				loading="lazy"
				decoding="async"
				referrerpolicy="no-referrer"
				onerror="this.parentElement.classList.remove('has-thumb');this.remove()"
			/>
		)
	}
	<StarlightIcon name="right-arrow" size="1.333em" class="icon rtl:flip" />
</div>

<style>
	.sl-link-card {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 1rem;
		box-shadow: var(--sl-shadow-sm);
		position: relative;
	}

	.sl-link-card.has-thumb {
		grid-template-columns: minmax(0, 1fr) auto auto;
		gap: 0.75rem;
	}

	.stack {
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
	}

	a {
		text-decoration: none;
		line-height: var(--sl-line-height-headings);
	}

	/* a11y fix for https://github.com/withastro/starlight/issues/487 */
	a::before {
		content: '';
		position: absolute;
		inset: 0;
	}

	.title {
		color: var(--sl-color-white);
		font-weight: 600;
		font-size: var(--sl-text-lg);
		overflow-wrap: anywhere;
	}

	.description {
		color: var(--sl-color-gray-3);
		line-height: 1.5;
	}

	.icon {
		color: var(--sl-color-gray-3);
	}

	/* 正方形の枠に収める。contain なので余白ができる。その余白は枠の背景で埋める（ライト・ダーク両方で馴染む色）。 */
	.thumb {
		box-sizing: border-box;
		width: 5rem;
		height: 5rem;
		object-fit: cover;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		/* White in both themes: OGP images (logos on transparent PNGs) are drawn for a light page. */
		background: #fff;
		pointer-events: none;
	}

	@media (max-width: 30rem) {
		.thumb {
			width: 3.5rem;
			height: 3.5rem;
		}
	}

	.sl-link-card:hover {
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
		border-color: var(--sl-color-gray-2);
	}

	.sl-link-card:hover .icon {
		color: var(--sl-color-white);
	}
</style>
