              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/roles/UseCaseRole.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16
                }
              },
              "message": {
                "text": "Declared here"
              }
            }
          ],
          "properties": {
            "kind": "FileConstraint",
            "severity": "Error",
            "path": "core/domain/src/main/kotlin/com/example/domain/GetUserUseCase.kt",
            "role": "domain.UseCase",
            "constraint": "外から使えること",
            "declaration": "GetUserUseCase",
            "layoutPath": "core/domain",
            "declaredAt": "UseCaseRole.kt:16"
          }
        },
        {
          "ruleId": "TodoRule",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Rule: TODO\nLine: 12"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/app/src/main/kotlin/com/example/Broken.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "properties": {
            "kind": "FileConstraint",
            "severity": "Error",
            "path": "app/src/main/kotlin/com/example/Broken.kt"
          }
        },
        {
          "ruleId": "BareRule",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "[BareRule] app/src/main/kotlin/com/example/Broken.kt"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/app/src/main/kotlin/com/example/Broken.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "properties": {
            "kind": "FileConstraint",
            "severity": "Warning",
            "path": "app/src/main/kotlin/com/example/Broken.kt"
          }
        },
        {
          "ruleId": "katachi.StaleBaselineEntry",
          "ruleIndex": 6,
          "level": "error",
          "message": {
            "text": "Baseline: katachi-baseline.json (me.tbsten.katachi.check.LayoutCheck)\nRule: UnexpectedFile, allowed 2, found 0\n\nHow to fix:\n  - Every violation this entry held back is gone. Remove the entry by re-running the architecture test with\n      -Dkatachi.baseline.prune=true"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/katachi-baseline.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "properties": {
            "kind": "Stale",
            "severity": "Error",
            "path": "legacy/Old.kt",
            "check": "me.tbsten.katachi.check.LayoutCheck",
            "baseline": "katachi-baseline.json"
          }
        },
        {
          "ruleId": "katachi.AmbiguousLayout",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "2 roles claim this file, so it belongs to all of them.\nEvery constraint those roles declare is checked against it.\n\nDeclared by:\n  domain.UseCase    UseCaseRole.kt:16\n  domain.Repository RepositoryRole.kt:9\n\nHow to fix:\n  - Narrow one of the two declarations so that each of these files is claimed by one role\n  - Or keep the overlap, and make every constraint of both roles hold for these files"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/core/domain/src/main/kotlin/com/example/domain/Shared.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/roles/RepositoryRole.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9
                }
              },
              "message": {
                "text": "Also claimed by domain.Repository"
              }
            }
          ],
          "properties": {
            "kind": "Ambiguous",
            "severity": "Warning",
            "path": "core/domain/src/main/kotlin/com/example/domain/Shared.kt",
            "role": "domain.UseCase,domain.Repository",
            "declaredAt": "UseCaseRole.kt:16"
          }
        },
        {
          "ruleId": "katachi.MissingDescription",
          "ruleIndex": 4,
          "level": "warning",
          "message": {
            "text": "Role domain.Repository may live in 2 places, and this one does not say when to use it.\nOther place: feature/cart/data\nDeclared at: RepositoryRole.kt:9\n\nHow to fix:\n  - Write `description = \"...\"` in this block, saying which files belong here rather than in the others\n  - Or merge this place into another if the two are really the same place"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/roles/RepositoryRole.kt",
                  "uriBaseId": "%SRCROOT%"
