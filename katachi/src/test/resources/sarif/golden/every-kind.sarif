            "severity": "Error",
            "path": "build"
          }
        },
        {
          "ruleId": "katachi.UncheckedCheck",
          "ruleIndex": 7,
          "level": "error",
          "message": {
            "text": "Katachi failed while running com.example.TodoCheck, so nothing it would have reported is known.\nCause: java.lang.IllegalStateException: broken check\n\nHow to fix:\n  - Read the cause above and fix the check, or stop passing it to assert()\n  - Report it at https://github.com/TBSten/katachi/issues if the check is one of katachi's"
          },
          "locations": [
            {
              "physicalLocation": {
