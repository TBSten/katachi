{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "katachi",
          "semanticVersion": "0.0.0-test",
          "informationUri": "https://tbsten.github.io/katachi/",
          "rules": [
            {
              "id": "BareRule",
              "name": "BareRule",
              "shortDescription": {
                "text": "Reported by a check outside katachi."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "TodoRule",
              "name": "TodoRule",
              "shortDescription": {
                "text": "Reported by a check outside katachi."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.AmbiguousLayout",
              "name": "AmbiguousLayout",
              "shortDescription": {
                "text": "Two or more roles claim the same path."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "katachi.CaptureMismatch",
              "name": "CaptureMismatch",
              "shortDescription": {
                "text": "A file matches a layout pattern, but the levels one capture names do not hold the same value."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.MissingDescription",
              "name": "MissingDescription",
              "shortDescription": {
                "text": "A role that may live in more than one place has a place without a description."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "katachi.MissingFile",
              "name": "MissingFile",
              "shortDescription": {
                "text": "A file a role declared without a wildcard does not exist."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.StaleBaselineEntry",
              "name": "StaleBaselineEntry",
              "shortDescription": {
                "text": "A baseline entry holds back more violations than the project still has."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UncheckedCheck",
              "name": "UncheckedCheck",
              "shortDescription": {
                "text": "A check handed to assert(...) threw, so nothing it would have reported is known."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UncheckedDirectory",
              "name": "UncheckedDirectory",
              "shortDescription": {
                "text": "The check failed at this directory, so part of what it would have said is unknown."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UncheckedFile",
              "name": "UncheckedFile",
              "shortDescription": {
                "text": "The check failed at this file, so nothing is known about it."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UncheckedFileConstraint",
              "name": "UncheckedFileConstraint",
              "shortDescription": {
                "text": "A file constraint was not evaluated or failed, so the run is a partial result."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UnexpectedDirectory",
              "name": "UnexpectedDirectory",
              "shortDescription": {
                "text": "A directory exists that no role's layout mentions. Nothing below it was checked."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UnexpectedFile",
              "name": "UnexpectedFile",
              "shortDescription": {
                "text": "A file exists that no role's layout allows."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "katachi.UnsatisfiedFileConstraint",
              "name": "UnsatisfiedFileConstraint",
              "shortDescription": {
                "text": "A file constraint (fileConstraint { } or konsist { }) rejected a file."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file:///w/repo/"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "katachi.UnexpectedFile",
          "ruleIndex": 12,
          "level": "error",
          "message": {
            "text": "No role is defined for this file.\n\nNearby locations:\n  domain.UseCase core/domain/src/main/kotlin/com/example/domain/\n\nHow to fix:\n  - Move it to one of the locations above\n  - Delete it if it is not needed\n  - Add a new role for it:\n      \"Helper\".role {\n        summary = \"TODO\"\n        layout {\n          \"app/src/main/kotlin/com/example\" / \"Helper\".ktFile()\n        }\n      }"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/app/src/main/kotlin/com/example/Helper.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "properties": {
            "kind": "Unexpected",
            "severity": "Error",
            "path": "app/src/main/kotlin/com/example/Helper.kt"
          }
        },
        {
          "ruleId": "katachi.UnexpectedDirectory",
          "ruleIndex": 11,
          "level": "error",
          "message": {
            "text": "No role is defined for this directory. Nothing below it was checked.\n\nHow to fix:\n  - Delete it if it is not needed\n  - Declare what belongs in it in the layout of an existing role\n  - Add a new role for it:\n      \"Legacy\".role {\n        summary = \"TODO\"\n        layout {\n          \"legacy\" { ignore() }\n        }\n      }"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/ProjectArchitecture.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/legacy",
                  "uriBaseId": "%SRCROOT%"
                }
              },
              "message": {
                "text": "The directory nothing declared"
              }
            }
          ],
          "properties": {
            "kind": "Unexpected",
            "severity": "Error",
            "path": "legacy"
          }
        },
        {
          "ruleId": "katachi.CaptureMismatch",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "The file matches a pattern of role domain.UseCase, but the levels named by capture(\"feature\") do not agree.\nPattern: feature/${feature}/src/main/kotlin/com/example/feature/${feature}/<feature.pascalCase>Screen.kt\nfeature: \"home\" at level 2, \"settings\" at level 8 (expected \"home\")\nfeature.pascalCase: \"Home\" at level 9\nDeclared at: UseCaseRole.kt:16\n\nHow to fix:\n  - Move it so that every level named feature reads \"home\":\n      feature/home/src/main/kotlin/com/example/feature/home/HomeScreen.kt\n  - Delete it if it is not needed\n  - If the two levels may differ, give them different names in the layout at UseCaseRole.kt:16"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/feature/home/src/main/kotlin/com/example/feature/settings/HomeScreen.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/roles/UseCaseRole.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16
                }
              },
              "message": {
                "text": "Declared here"
              }
            }
          ],
          "properties": {
            "kind": "Unexpected",
            "severity": "Error",
            "path": "feature/home/src/main/kotlin/com/example/feature/settings/HomeScreen.kt"
          }
        },
        {
          "ruleId": "katachi.MissingFile",
          "ruleIndex": 5,
          "level": "error",
          "message": {
            "text": "No file has been created yet for role domain.UseCase.\nDeclared at: UseCaseRole.kt:16\n\nHow to fix:\n  - If it is not implemented yet, this error is expected\n  - If it is no longer needed, remove the declaration at UseCaseRole.kt:16"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/roles/UseCaseRole.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16
                }
              }
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/core/domain/src/main/kotlin/com/example/domain/GetOrderUseCase.kt",
                  "uriBaseId": "%SRCROOT%"
                }
              },
              "message": {
                "text": "The declared file, which does not exist"
              }
            }
          ],
          "properties": {
            "kind": "Missing",
            "severity": "Error",
            "path": "core/domain/src/main/kotlin/com/example/domain/GetOrderUseCase.kt",
            "role": "domain.UseCase",
            "declaredAt": "UseCaseRole.kt:16"
          }
        },
        {
          "ruleId": "katachi.UnsatisfiedFileConstraint",
          "ruleIndex": 13,
          "level": "error",
          "message": {
            "text": "Role: domain.UseCase / FileConstraint: \"外から使えること\"\nDeclaration: GetUserUseCase (line 7)\nDeclared at: UseCaseRole.kt:16 (layout of core/domain)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/core/domain/src/main/kotlin/com/example/domain/GetUserUseCase.kt",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7
