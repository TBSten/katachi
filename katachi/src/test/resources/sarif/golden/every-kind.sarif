        },
        {
          "ruleId": "katachi.UncheckedDirectory",
          "ruleIndex": 8,
          "level": "error",
          "message": {
            "text": "Katachi failed while checking this directory. Nothing below it was checked.\nCause: java.io.IOException: Permission denied\n\nHow to fix:\n  - Check that the directory is readable, then run the check again\n  - If it is, report this at https://github.com/TBSten/katachi/issues with the cause above"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/architecture-test/src/test/kotlin/com/example/ProjectArchitecture.kt",
                  "uriBaseId": "%SRCROOT%"
                },
