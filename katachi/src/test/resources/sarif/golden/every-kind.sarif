          "ruleIndex": 10,
          "level": "error",
          "message": {
            "text": "Nothing evaluated this constraint, so nothing is known about it.\nRole: domain.Repository\nDeclared at: RepositoryRole.kt:9\n\nHow to fix:\n  - Pass FileConstraintCheck() to assert(): projectArchitecture.assert(FileConstraintCheck())\n  - Remove the constraint at RepositoryRole.kt:9 if it is no longer wanted"
          },
          "locations": [
