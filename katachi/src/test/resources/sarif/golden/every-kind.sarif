            "severity": "Warning",
            "path": "core/data",
            "role": "domain.Repository",
            "declaredAt": "RepositoryRole.kt:9"
          }
        },
        {
          "ruleId": "katachi.UncheckedFile",
          "ruleIndex": 9,
          "level": "error",
          "message": {
            "text": "Katachi failed while checking this file, so nothing is known about it.\nCause: java.lang.IllegalStateException: unreadable\n\nHow to fix:\n  - Check that the file is readable, then run the check again\n  - If it is, report this at https://github.com/TBSten/katachi/issues with the cause above"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "android/app/src/main/kotlin/com/example/Broken.kt",
                  "uriBaseId": "%SRCROOT%"
