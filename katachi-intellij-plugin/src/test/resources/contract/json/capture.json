      "summary": "feature/<feature>/src に置く",
      "parameterNames": ["name"],
      "conflict": false,
      "captures": [
        {"name": "feature", "kind": "PathCapture", "pattern": "feature/*/src/*ViewModel.kt", "segment": "${feature}", "position": 1}
