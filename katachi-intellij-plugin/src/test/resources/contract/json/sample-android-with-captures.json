      ],
      "files": [
        {
          "fileName": "Home${name}Test.kt",
          "path": "feature/home/src/test/kotlin/com/example/sample/feature/home/Home${name}Test.kt",
          "unresolvedPatterns": [],
          "content": "package com.example.sample.feature.home\n\nimport com.example.sample.testing.FakeUserRepository\nimport com.example.sample.ui.core.UiState\nimport org.junit.Assert.assertEquals\nimport org.junit.Test\n\nclass Home${name}Test {\n    @Test\n    fun `リポジトリから読んだ値を Content として公開する`() {\n        val viewModel = HomeViewModel(userRepository = FakeUserRepository(userName = \"katachi\"))\n\n        assertEquals(UiState.Content(HomeContent(userName = \"katachi\", visitCount = 1)), viewModel.uiState.value)\n    }\n}"
        }
      ],
      "branches": [
        {
          "parameterName": "screen",
          "value": "Settings",
          "addedFiles": ["Settings${name}Test.kt"],
          "removedFiles": ["Home${name}Test.kt"],
          "addedParameters": [],
          "removedParameters": []
        }
      ],
      "exampleCommand": "./gradlew katachiTemplate --arg roleName=feature/FeatureTest --arg screen=Home",
      "captures": []
    },
