<idea-plugin>
    <id>me.tbsten.katachi.intellij</id>
    <name>katachi</name>
    <vendor url="https://github.com/tbsten/katachi">tbsten</vendor>
    <!-- The version, since-build and until-build are patched in from build.gradle.kts. -->
    <description><![CDATA[
        <p><b>Experimental.</b> An early preview released together with katachi 0.2.0: its screens and
        behavior may change in any release. It is not on JetBrains Marketplace; it is distributed as a zip
        attached to each <a href="https://github.com/TBSten/katachi/releases">GitHub Release</a>
        and installed with Settings &gt; Plugins &gt; Install Plugin from Disk.</p>
        <p>Generate code from the templates of your katachi architecture.
        Start from the katachi tool window, from New &gt; katachi in the Project tree, or from the notification
        that appears in the editor when a template fits the file you opened (it can be turned off in Settings &gt; Tools &gt; katachi).
        Pick a template, fill in its arguments and press Generate; katachi's Gradle task writes the files.
        The screens follow the IDE's language: Japanese when the IDE is in Japanese, English otherwise.</p>
        <p>Needs a Gradle project that applies the katachi Gradle plugin 0.2.0 or later (<code>id("me.tbsten.katachi")</code>).
        See <a href="https://tbsten.github.io/katachi/guides/generate-code-from-template/">Generate code from template</a>.</p>
    ]]></description>
    <change-notes><![CDATA[
        <p>0.1.0 (with katachi 0.2.0): the first release, experimental. The katachi tool window, New &gt; katachi, and the editor
        notification on files a template fits, in English and Japanese.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <!-- Detection reads the Gradle sync data; loading and generating run Gradle through ExternalSystem. -->
    <depends>com.intellij.gradle</depends>
    <!-- ChangeListManager / ProjectLevelVcsManager (VCS-ignored and untracked files). Up to 2026.2 (262) these classes are in the platform;
         2026.3 (263) moved them to the bundled "Version Control" plugin, whose content module intellij.platform.vcs.impl declares this alias,
         and the 2026.3 API changes say the alias is sufficient. A real 263 loads them with this line alone (integrationTest263); verifyPlugin
         reports them unresolved there all the same, so verifyPlugin-ignored-problems.txt holds those reports back. -->
    <depends>com.intellij.modules.vcs</depends>
    <!-- The Analysis API. TODO: make it optional (config-file) if nothing ends up needing it. -->
    <depends>org.jetbrains.kotlin</depends>

    <!-- v2 module dependencies, paired with bundledModule(...) in build.gradle.kts, so that Jewel and
         Compose are resolved from the IDE through the plugin classloader. -->
    <dependencies>
        <module name="intellij.platform.jewel.foundation"/>
        <module name="intellij.platform.jewel.ui"/>
        <module name="intellij.platform.jewel.ideLafBridge"/>
        <module name="intellij.libraries.compose.runtime.desktop"/>
        <module name="intellij.libraries.compose.foundation.desktop"/>
        <module name="intellij.libraries.skiko"/>
    </dependencies>

    <!-- Paired with the idea.kotlin.plugin.use.k2 system property of the test task. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <resource-bundle>messages.KatachiBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- The id is the tool window's title; the screen spec calls it `katachi`. -->
        <toolWindow id="katachi" anchor="right" icon="/icons/katachi.svg" factoryClass="me.tbsten.katachi.intellij.ide.KatachiToolWindowFactory"/>
        <notificationGroup id="katachi" displayType="BALLOON" bundle="messages.KatachiBundle" key="notification.group"/>
        <projectConfigurable parentId="tools" id="me.tbsten.katachi.intellij.settings" instance="me.tbsten.katachi.intellij.ide.KatachiConfigurable"
                             bundle="messages.KatachiBundle" key="settings.displayName" nonDefaultProject="true"/>
        <!-- The "definition changed" banner (E-44). -->
        <vfs.asyncListener implementation="me.tbsten.katachi.intellij.ide.KatachiFileWatcher"/>
        <!-- The editor notification on files a template fits (design section 1). -->
        <editorNotificationProvider implementation="me.tbsten.katachi.intellij.ide.notification.KatachiEditorNotificationProvider"/>
        <!-- The notification on a file no role holds (ide-display-rules-for-file, issue 13). -->
        <editorNotificationProvider implementation="me.tbsten.katachi.intellij.ide.notification.NoRoleNotificationProvider"/>
        <!-- The content of .ktFile().template { } / .ktsFile().template { } highlighted as Kotlin / Kotlin script. -->
        <multiHostInjector implementation="me.tbsten.katachi.intellij.ide.injection.KatachiTemplateInjector"/>
        <!-- The ◆ of the source files a role holds (ide-gutter design 2.1), listed in Settings | Editor | General | Gutter Icons. -->
        <codeInsight.lineMarkerProvider language="kotlin" implementationClass="me.tbsten.katachi.intellij.ide.gutter.KatachiDeclarationLineMarkerProvider"/>
        <!-- Every other language (.md, .xml, .toml, plain text): one ◆ at the top of the file. Kotlin is left to the provider above. Both share one switch there. -->
        <codeInsight.lineMarkerProvider language="" implementationClass="me.tbsten.katachi.intellij.ide.gutter.KatachiFileLineMarkerProvider"/>
        <!-- The violations of the last check, under the declaration they reject (ide-gutter design 2.5); Problems lists them too. -->
        <externalAnnotator language="kotlin" implementationClass="me.tbsten.katachi.intellij.ide.gutter.annotator.KatachiViolationAnnotator"/>

        <!-- L-A (ide-authoring): completion of the names in the strings of a definition -->
        <!-- captureValue("|"), a templateSet's template("|") and arg("|"). First, so that the names are on top; it never stops Kotlin's own. -->
        <completion.contributor language="kotlin" order="first" implementationClass="me.tbsten.katachi.intellij.ide.authoring.completion.DefinitionCompletionContributor"/>
        <!-- Kotlin stops an automatic popup inside a string; not inside these. -->
        <completion.confidence language="kotlin" order="before kotlinSkipAutopopupInStrings" implementationClass="me.tbsten.katachi.intellij.ide.authoring.completion.DefinitionCompletionConfidence"/>
        <!-- The quote that opens such a string opens the popup. -->
        <typedHandler implementation="me.tbsten.katachi.intellij.ide.authoring.completion.DefinitionTypedHandler"/>
        <!-- What katachi found wrong with the definition (ide-authoring design 2.4): underlined where it was written, and a banner in the definition module's test sources. -->
        <externalAnnotator language="kotlin" implementationClass="me.tbsten.katachi.intellij.ide.authoring.errors.DefinitionErrorAnnotator"/>
        <editorNotificationProvider implementation="me.tbsten.katachi.intellij.ide.authoring.errors.DefinitionErrorNotificationProvider"/>
        <!-- The ◆ of a definition file: a role, and a .template { } (ide-authoring design 4.3). Its own switch in Settings | Editor | General | Gutter Icons. -->
        <codeInsight.lineMarkerProvider language="kotlin" implementationClass="me.tbsten.katachi.intellij.ide.authoring.gutter.KatachiDefinitionLineMarkerProvider"/>
        <!-- How many files a layout line holds, at the end of the line (design 4.3), and its group in Settings | Editor | Inlay Hints | Code Vision. -->
        <codeInsight.daemonBoundCodeVisionProvider implementation="me.tbsten.katachi.intellij.ide.authoring.codevision.EntryFilesCodeVisionProvider"/>
        <config.codeVisionGroupSettingProvider implementation="me.tbsten.katachi.intellij.ide.authoring.codevision.KatachiCodeVisionGroup"/>
        <!-- end of L-A -->
    </extensions>

    <actions>
        <action id="katachi.GenerateFromTemplate" class="me.tbsten.katachi.intellij.ide.GenerateFromTemplateAction" icon="/icons/katachi.svg"/>
        <!-- New > katachi (issue 12). Its text is group.katachi.NewGroup.text of the bundle; right after
             "Directory" / "Package", before the file templates. NewDir is the platform's, so it exists in
             Android Studio too. -->
        <group id="katachi.NewGroup" class="me.tbsten.katachi.intellij.ide.newmenu.KatachiNewGroup" popup="true" icon="/icons/katachi.svg">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewDir"/>
        </group>
        <!-- Read the definition again through Gradle (design 4.8); the gutter and the notification call it. -->
        <action id="katachi.RefreshDefinition" class="me.tbsten.katachi.intellij.ide.RefreshDefinitionAction" icon="/icons/katachi.svg"/>
        <!-- Run the check (:<module>:test) that writes katachi.sarif (design 4.7); the gutter and the notification call it. -->
        <action id="katachi.RunCheck" class="me.tbsten.katachi.intellij.ide.sarif.RunCheckAction" icon="/icons/katachi.svg"/>
        <!-- Copy a .role declaration for a file, the draft the test report suggests; the no-role popup has the same row. -->
        <action id="katachi.CopyRoleSuggestion" class="me.tbsten.katachi.intellij.ide.rules.CopyRoleSuggestionAction" icon="/icons/katachi.svg"/>
    </actions>
</idea-plugin>
