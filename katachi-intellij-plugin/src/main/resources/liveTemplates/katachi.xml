<!--
  - The names come from the file's name, as the samples name their files: ServiceRole.kt gives "Service" and service(),
    DomainGroup.kt gives "Domain" and domainGroup().
  - Names are written fully qualified so that toShortenFQNames adds the imports.
  - kcontent and ktemplate carry @OptIn(ExperimentalKatachiApi::class) so that they compile in a file without @file:OptIn.
-->
<templateSet group="katachi">
    <template name="krole"
              value="fun me.tbsten.katachi.dsl.DeclarationContainerScope.$FUNCTION$() = &quot;$NAME$&quot;.role {&#10;    title = &quot;$TITLE$&quot;&#10;    summary = &quot;$SUMMARY$&quot;&#10;&#10;    layout {&#10;        $END$&#10;    }&#10;}"
              resource-bundle="messages.KatachiBundle" key="liveTemplate.krole"
              toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="capitalize(regularExpression(fileNameWithoutExtension(), &quot;Role$&quot;, &quot;&quot;))" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
        <variable name="FUNCTION" expression="decapitalize(NAME)" defaultValue="" alwaysStopAt="false"/>
        <variable name="TITLE" expression="NAME" defaultValue="" alwaysStopAt="true"/>
        <variable name="SUMMARY" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="KOTLIN_TOPLEVEL" value="true"/>
        </context>
    </template>
    <template name="kgroup"
              value="fun me.tbsten.katachi.dsl.DeclarationContainerScope.$FUNCTION$Group() = &quot;$NAME$&quot;.group {&#10;    title = &quot;$TITLE$&quot;&#10;    summary = &quot;$SUMMARY$&quot;&#10;&#10;    $END$&#10;}"
              resource-bundle="messages.KatachiBundle" key="liveTemplate.kgroup"
              toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="capitalize(regularExpression(fileNameWithoutExtension(), &quot;Group$&quot;, &quot;&quot;))" defaultValue="&quot;Name&quot;" alwaysStopAt="true"/>
        <variable name="FUNCTION" expression="decapitalize(NAME)" defaultValue="" alwaysStopAt="false"/>
        <variable name="TITLE" expression="NAME" defaultValue="" alwaysStopAt="true"/>
        <variable name="SUMMARY" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="KOTLIN_TOPLEVEL" value="true"/>
        </context>
    </template>
    <template name="karch"
              value="val $NAME$ = me.tbsten.katachi.dsl.architecture {&#10;    $END$&#10;}"
              resource-bundle="messages.KatachiBundle" key="liveTemplate.karch"
              toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="" defaultValue="&quot;projectArchitecture&quot;" alwaysStopAt="true"/>
        <context>
            <option name="KOTLIN_TOPLEVEL" value="true"/>
        </context>
    </template>
    <template name="kcontent"
              value="@OptIn(me.tbsten.katachi.ExperimentalKatachiApi::class)&#10;private fun me.tbsten.katachi.dsl.RoleScope.$NAME$FileContent() = me.tbsten.katachi.konsist.declarations.ktFileContent {&#10;    `package`(&quot;$PACKAGE$&quot;)&#10;&#10;    required(`class`, fileName) {&#10;        $END$&#10;    }&#10;}"
              resource-bundle="messages.KatachiBundle" key="liveTemplate.kcontent"
              toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="decapitalize(regularExpression(fileNameWithoutExtension(), &quot;Role$&quot;, &quot;&quot;))" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="PACKAGE" expression="" defaultValue="&quot;**&quot;" alwaysStopAt="true"/>
        <context>
            <option name="KOTLIN_TOPLEVEL" value="true"/>
        </context>
    </template>
    <template name="ktemplate"
              value="@OptIn(me.tbsten.katachi.ExperimentalKatachiApi::class)&#10;private fun me.tbsten.katachi.dsl.TemplateScope.$NAME$Template(): String {&#10;    val $CAPTURE$ = captureValue(&quot;$CAPTURE$&quot;)&#10;    return &quot;&quot;&quot;&#10;        $END$&#10;    &quot;&quot;&quot;.trimIndent() + &quot;\n&quot;&#10;}"
              resource-bundle="messages.KatachiBundle" key="liveTemplate.ktemplate"
              toReformat="true" toShortenFQNames="true">
        <variable name="NAME" expression="decapitalize(regularExpression(fileNameWithoutExtension(), &quot;Role$&quot;, &quot;&quot;))" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <variable name="CAPTURE" expression="" defaultValue="&quot;name&quot;" alwaysStopAt="true"/>
        <context>
            <option name="KOTLIN_TOPLEVEL" value="true"/>
        </context>
    </template>
</templateSet>
