#!/bin/sh
# The `katachi` command. Homebrew's wrapper sets KATACHI_HOME to where katachi.main.kts was unpacked; run
# from a bare tarball, it is the directory above this one.
set -eu

if [ -z "${KATACHI_HOME:-}" ]; then
	KATACHI_HOME=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fi
export KATACHI_HOME

if ! command -v kotlin >/dev/null 2>&1; then
	printf '\n[x] %s\n' "kotlin is not on PATH. Install it with: brew install kotlin" >&2
	exit 1
fi

# `kotlin` takes every -D… / -J… on its command line for its own JVM, even after the script, so
# `katachi agent test -- -Dkatachi.baseline.update=true` would never see its -D…. Mark them (and anything
# already starting with the mark); katachi-script's main() strips the mark (WRAPPER_ARG_ESCAPE).
escape='katachi-escaped:'
for arg do
	shift
	case $arg in
	-D* | -J* | "$escape"*) set -- "$@" "$escape$arg" ;;
	*) set -- "$@" "$arg" ;;
	esac
done

exec kotlin "$KATACHI_HOME/katachi.main.kts" "$@"
